# Copy to deploy.env (git-ignored) and fill in. Read by scripts/deploy_lambda.sh.

# --- AWS
AWS_PROFILE=default
AWS_REGION=eu-central-1
FUNCTION_NAME=cortex-agent-gateway
ROLE_NAME=cortex-agent-gateway-role
SECRET_NAME=cortex-agent-gateway/config
# Local JSON with the secrets (never commit it). See secret.json.example.
SECRET_FILE=~/.cortex-agent-whatsapp/secret.json
# Fixed egress IP: put the Lambda in private subnets whose route goes out through a NAT gateway with an
# Elastic IP (or your corporate egress). Leave empty for no VPC (egress IP changes on every cold start,
# which does NOT work with a Snowflake network policy).
SUBNET_IDS=
SECURITY_GROUP_IDS=
# Caps parallel executions (cost and abuse guard for a public URL).
RESERVED_CONCURRENCY=10

# --- Snowflake (non-secret, become Lambda environment variables)
# <orgname>-<account_name>.snowflakecomputing.com (use hyphens, not underscores)
SNOWFLAKE_HOST=myorg-myaccount.snowflakecomputing.com
AGENT_FQN=MY_DB.AGENTS.WHATSAPP_ASSISTANT
BOT_ROLE=CAWA_BOT_ROLE
BOT_WAREHOUSE=COMPUTE_WH
STATE_SCHEMA=MY_DB.CAWA_STATE

# --- Behaviour
TIMEZONE=Europe/Madrid
# en | es: language of the gateway's own canned messages (reset, errors). The agent answers in the user's language.
BOT_LANG=en
# false = WhatsApp only (no public web chat page or /api/chat)
ENABLE_WEB=true
HISTORY_TURNS=12
# true = prefix each user message with [channel=..; user_phone=..; today=..] for the agent
CONTEXT_LINE=true
